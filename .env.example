# Copy to /srv/xclipboard/.env (next to the repo, not inside it) and fill in.

# UID/GID of the xclipboard system user (from: id xclipboard). The container runs as this user.
APP_UID=
APP_GID=

# Token for the admin endpoints
ADMIN_TOKEN=

# Containers default to UTC; set this so log timestamps and daily log file names use local time
TZ=America/New_York
